# PS1 is the prompt string that precedes a bash command
# Color tag: \[\033[COLOR_CODE m\]
# \u: username (i.e. kevinly)
# \h: hostname
# \w: partial working directory (starts from user home directory ~ if possible; else from root "/")
PS1="\[\033[01;32m\]\u@work\[\033[00m\]:\[\033[01;31m\]\w\[\033[00m\]\$"

